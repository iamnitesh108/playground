{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EverythingInCatalog",
      "Effect": "Allow",
      "Action": ["s3:*"],
      "Resource": ["arn:aws:s3:::catalog", "arn:aws:s3:::catalog/*"]
    },
    {
      "Sid": "NeverDeleteInvoices",
      "Effect": "Deny",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::catalog/invoices/*"]
    }
  ]
}
